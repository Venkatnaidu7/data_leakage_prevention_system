# DLP System Environment Configuration
# Copy this file to .env and replace placeholders with secure values.
# NEVER commit .env to source control!

APP_ENV=development
FLASK_APP=app:create_app
FLASK_DEBUG=false

# Security: Secret key for session management and CSRF protection
# In production, generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-secret-key-change-in-production-min32chars

# Database: SQLite for development/testing, PostgreSQL for production
# Example SQLite: sqlite:///dlp_dev.db
# Example Postgres: postgresql+psycopg://dlp_user:dlp_password@localhost:5432/dlp_system
DATABASE_URL=sqlite:///dlp_dev.db

# Cookie & Session Security
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_MINUTES=60

# File Upload / Scanning limits
MAX_CONTENT_LENGTH_BYTES=10485760  # 10 MB limit
ALLOWED_EXTENSIONS=txt,csv,json,xml,md,log,yaml,yml

# Rate Limiting
RATELIMIT_DEFAULT=100/minute
RATELIMIT_AUTH=10/minute

# Logging
LOG_LEVEL=INFO
